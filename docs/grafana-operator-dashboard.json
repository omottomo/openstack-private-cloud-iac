{
  "dashboard": {
    "uid": "openstack-operator",
    "title": "OpenStack 오퍼레이터 시야 (openstack-exporter)",
    "tags": ["openstack", "phase-4"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "refresh": "1m",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "type": "stat",
        "title": "OpenStack 서비스 API 상태",
        "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "refId": "A", "expr": "{__name__=~\"openstack_.*_up\"}", "legendFormat": "{{__name__}}", "instant": true }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "textMode": "value_and_name",
          "colorMode": "background",
          "orientation": "horizontal"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }
            ],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
          },
          "overrides": []
        }
      },
      {
        "type": "stat",
        "title": "총 VM 수",
        "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [{ "refId": "A", "expr": "openstack_nova_total_vms", "instant": true }],
        "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" },
        "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] }
      },
      {
        "type": "stat",
        "title": "Floating IP 수",
        "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [{ "refId": "A", "expr": "openstack_neutron_floating_ips", "instant": true }],
        "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" },
        "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] }
      },
      {
        "type": "stat",
        "title": "Glance 이미지 수",
        "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [{ "refId": "A", "expr": "openstack_glance_images", "instant": true }],
        "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" },
        "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] }
      },
      {
        "type": "table",
        "title": "Nova 서비스별 상태 (openstack_nova_agent_state)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [{ "refId": "A", "expr": "openstack_nova_agent_state", "instant": true, "format": "table" }],
        "transformations": [
          { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "id": true }, "renameByName": { "hostname": "호스트", "service": "서비스", "adminState": "관리 상태", "Value": "상태(1=up)" } } }
        ],
        "fieldConfig": {
          "defaults": { "custom": { "align": "auto" } },
          "overrides": [
            { "matcher": { "id": "byName", "options": "상태(1=up)" }, "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }] },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }
            ] }
          ]
        }
      },
      {
        "type": "table",
        "title": "Neutron 에이전트 상태 (openstack_neutron_agent_state)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [{ "refId": "A", "expr": "openstack_neutron_agent_state", "instant": true, "format": "table" }],
        "transformations": [
          { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "id": true }, "renameByName": { "hostname": "호스트", "service": "에이전트", "adminState": "관리 상태", "Value": "상태(1=up)" } } }
        ],
        "fieldConfig": {
          "defaults": { "custom": { "align": "auto" } },
          "overrides": [
            { "matcher": { "id": "byName", "options": "상태(1=up)" }, "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } }] },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }
            ] }
          ]
        }
      },
      {
        "type": "gauge",
        "title": "하이퍼바이저 자원 사용률 (Placement)",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "refId": "A", "expr": "100 * openstack_placement_resource_usage / openstack_placement_resource_total", "legendFormat": "{{resourcetype}}", "instant": true }
        ],
        "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
        "fieldConfig": {
          "defaults": {
            "unit": "percent", "min": 0, "max": 100,
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
          },
          "overrides": []
        }
      },
      {
        "type": "timeseries",
        "title": "자원 사용량 추이 (usage / total)",
        "gridPos": { "h": 8, "w": 16, "x": 8, "y": 13 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [
          { "refId": "A", "expr": "openstack_placement_resource_usage", "legendFormat": "used {{resourcetype}}" },
          { "refId": "B", "expr": "openstack_placement_resource_total", "legendFormat": "total {{resourcetype}}" }
        ],
        "fieldConfig": {
          "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "auto" } },
          "overrides": []
        },
        "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
      },
      {
        "type": "timeseries",
        "title": "테넌트별 vCPU 사용량 (nova limits)",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [{ "refId": "A", "expr": "openstack_nova_limits_vcpus_used", "legendFormat": "{{tenant}}" }],
        "fieldConfig": {
          "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "auto" } },
          "overrides": []
        },
        "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
      },
      {
        "type": "table",
        "title": "VM 상태 (openstack_nova_server_status)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
        "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
        "targets": [{ "refId": "A", "expr": "openstack_nova_server_status", "instant": true, "format": "table" }],
        "transformations": [
          { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true, "id": true, "tenant_id": true, "user_id": true, "flavor_id": true, "image_id": true, "address_ipv4": true, "address_ipv6": true }, "renameByName": { "name": "VM 이름", "hypervisor_hostname": "하이퍼바이저", "status": "상태", "availability_zone": "AZ", "Value": "status code" } } }
        ],
        "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] }
      }
    ]
  },
  "overwrite": true,
  "message": "Operator dashboard (openstack-exporter)"
}
